# Build artifacts
bin
dist
build
out
*.log
# Bare names only match at the context root; nested installs (e.g.
# apps/dashboard/node_modules, full of pnpm symlinks into the excluded
# root store) must be excluded too or COPY clobbers the in-image install
# with broken links.
node_modules
**/node_modules
.next
**/.next
.venv
.venv-*
__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
coverage
test-reports

# Docs and ancillary
*.md
docs
examples
deploy
scripts
!scripts/
!scripts/generate-brand.mjs

# Don't ignore the runtime Dockerfile context
!services
!packages/sdk-go
!go.mod
!go.sum
