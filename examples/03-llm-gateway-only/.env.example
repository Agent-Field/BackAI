# Example 03: LLM Gateway Only — environment.
# Copy to .env and fill in OPENROUTER_API_KEY.
#
#   cp .env.example .env
#   # edit .env: paste your OpenRouter key
#
# Get a key:  https://openrouter.ai/keys  (free tier covers thousands of
# Qwen 2.5 72B calls at ~$0.0001 each)

# Required: LLM provider key. OpenRouter is the recommended quickstart
# because one key unlocks all the models in services/runtime/internal/
# pricing/pricing.go.
OPENROUTER_API_KEY=

# Required: signing secret for the dashboard session cookie. The dashboard
# is read-only in this example (multi-tenancy is off), but better-auth
# still wants a non-empty value. Generate one with:  openssl rand -hex 32
AF_STACK_AUTH_SECRET=change-me-to-a-real-secret

# Optional: swap providers without editing compose. See
# compose-override-example.yml for the alternative wiring.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
