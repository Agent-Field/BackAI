# Notable example — environment overrides.
#
# Copy to .env at the example root before `docker compose up`. Anything
# unset falls back to the dev defaults baked into docker-compose.yml.
#
# Two keys actually matter for a useful demo:
#   - OPENROUTER_API_KEY: lets the 3 agents call a real model. Without
#     this they boot and register but every reasoner short-circuits with
#     a "no model configured" error.
#   - AF_STACK_AUTH_SECRET: signs better-auth sessions. Keep it stable
#     across restarts so login state persists.

# ─── LLM provider (any one) ───────────────────────────────────────────────
# OpenRouter is the cheapest path to a working demo. Qwen 2.5 72B costs
# roughly $0.35 / 1M input tokens. A full seed pass (10 notes × 3 agents)
# stays well under one cent.
OPENROUTER_API_KEY=

# Optional fallbacks. The agents pick whichever key is set in this order:
# openrouter -> anthropic -> openai. Leave blank to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Stripe (optional) ────────────────────────────────────────────────────
# When STRIPE_SECRET_KEY is empty, the billing module runs in stub mode:
# customers get deterministic fake stripe_customer_id values, portal links
# point at example.com, and the seeder still wires everything up. This is
# the right setting for local dev — flip to a real test key only when you
# want to drive a real Stripe Checkout / portal flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Auth + KMS ───────────────────────────────────────────────────────────
# better-auth session signing key. Change this for any deployment that
# isn't your laptop. `openssl rand -hex 32` is a fine generator.
AF_STACK_AUTH_SECRET=dev-secret-change-me-in-prod

# Envelope-encryption key for the secrets vault. Same generator rule.
AF_STACK_KMS_KEY=dev-secret-change-me

# ─── Ports (override if you've got conflicts on the defaults) ────────────
AF_STACK_PORT=8080
AF_STACK_DASHBOARD_PORT=3000
NOTABLE_API_PORT=8090
