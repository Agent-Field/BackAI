# Deep Research example — environment template.
#
# Copy to .env and fill in your provider key. One key is enough to run
# the whole pipeline; the agent picks a cheap-but-capable default
# (Qwen 2.5 72B on OpenRouter) so a full research run lands sub-cent.

# ---------- LLM (required: pick one) ----------
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------- Harness (optional) ----------
#
# The researcher's fan-out step uses .harness() per sub-question. With
# claude-code installed on the host, each sub-investigation gets the
# real multi-turn treatment: the harness can read references, follow
# citations, and adapt as it goes.
#
# When the harness binary is MISSING, the agent probes once at startup
# and routes every sub-question through a mock fallback — a single
# .ai() call with a structured Finding schema. The example still
# demonstrates the full decompose -> fan-out -> accumulate -> synthesise
# flow; it just doesn't go as deep per sub-question.
#
# Install claude-code separately if you want the real harness path.
# RESEARCHER_HARNESS=claude-code
# RESEARCHER_HARNESS_MAX_TURNS=5
# RESEARCHER_HARNESS_BUDGET_USD=0.50

# ---------- Overrides (optional) ----------
#
# Pin a specific model. Otherwise the agent picks based on which key is set.
# RESEARCHER_MODEL=openrouter/qwen/qwen-2.5-72b-instruct

# Host ports — match the root .env if you've customised them.
# AF_STACK_PORT=8080
# AF_STACK_DASHBOARD_PORT=3000

LOG_LEVEL=info
